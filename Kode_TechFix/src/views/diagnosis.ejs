<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Diagnosis &amp; Estimasi - TechFix</title>
  <!-- Bootstrap 5 (CDN) -->
  <link
    href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
    rel="stylesheet"
  />
</head>
<body class="bg-light">

  <!-- Navbar -->
  <nav class="navbar navbar-dark bg-dark">
    <div class="container">
      <span class="navbar-brand mb-0 h1">TechFix &mdash; Panel Teknisi</span>
      <span class="navbar-text text-white-50">UC-03: Mendiagnosis dan Menyusun Estimasi</span>
    </div>
  </nav>

  <main class="container my-4">
    <h1 class="h4 mb-3">Tiket <span class="text-primary"><%= nomorTiket %></span></h1>

    <div class="row g-4">

      <!-- Kolom kiri: form diagnosis -->
      <div class="col-lg-7">
        <div class="card shadow-sm">
          <div class="card-header bg-primary text-white">Form Diagnosis</div>
          <div class="card-body">
            <form action="/api/tiket/<%= nomorTiket %>/diagnosis" method="post">
              <div class="mb-3">
                <label for="hasilDiagnosis" class="form-label">Hasil Diagnosis</label>
                <textarea
                  class="form-control"
                  id="hasilDiagnosis"
                  name="hasilDiagnosis"
                  rows="4"
                  placeholder="Contoh: LCD rusak, perlu penggantian"
                ></textarea>
              </div>

              <div class="row">
                <div class="col-md-8 mb-3">
                  <label for="sukuCadang" class="form-label">Suku Cadang</label>
                  <select class="form-select" id="sukuCadang" name="idSukuCadang">
                    <% if (daftarSukuCadang && daftarSukuCadang.length) { %>
                      <% daftarSukuCadang.forEach(function (sc) { %>
                        <option value="<%= sc.id_suku_cadang %>"><%= sc.nama %> - Rp<%= sc.harga %></option>
                      <% }); %>
                    <% } else { %>
                      <option value="">(data suku cadang belum dimuat)</option>
                    <% } %>
                  </select>
                </div>
                <div class="col-md-4 mb-3">
                  <label for="jumlah" class="form-label">Jumlah</label>
                  <input type="number" class="form-control" id="jumlah" name="jumlah" value="1" min="1" />
                </div>
              </div>

              <button type="submit" class="btn btn-primary">Simpan Diagnosis</button>
            </form>
          </div>
        </div>
      </div>

      <!-- Kolom kanan: ringkasan estimasi -->
      <div class="col-lg-5">
        <div class="card shadow-sm">
          <div class="card-header bg-success text-white">Ringkasan Estimasi</div>
          <div class="card-body">
            <% if (estimasi) { %>
              <ul class="list-group list-group-flush">
                <li class="list-group-item d-flex justify-content-between">
                  <span>Biaya Jasa</span><strong>Rp<%= estimasi.biayaJasa %></strong>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                  <span>Biaya Sparepart</span><strong>Rp<%= estimasi.biayaSparepart %></strong>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                  <span>Total</span><strong class="text-success">Rp<%= estimasi.totalBiaya %></strong>
                </li>
                <li class="list-group-item d-flex justify-content-between">
                  <span>Estimasi Waktu</span><span><%= estimasi.estimasiWaktu %></span>
                </li>
              </ul>
            <% } else { %>
              <p class="text-muted mb-0">
                Belum ada estimasi. Isi diagnosis dan pilih suku cadang, lalu kirim estimasi.
              </p>
            <% } %>
          </div>
        </div>

        <form class="mt-3" action="/api/tiket/<%= nomorTiket %>/estimasi/kirim" method="post">
          <button type="submit" class="btn btn-success w-100">Kirim Estimasi ke Pelanggan</button>
        </form>
      </div>

    </div>
  </main>

  <!-- Bootstrap 5 JS (CDN) -->
  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
